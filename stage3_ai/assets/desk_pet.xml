<mujoco model="desk_pet">
  <compiler angle="radian" meshdir="stl" balanceinertia="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" iterations="50" solver="Newton" cone="elliptic"/>

  <default>
    <joint damping="0.002" armature="0.001" frictionloss="0.005"/>
    <geom contype="1" conaffinity="1" condim="3" friction="0.8 0.01 0.001"/>
    <site size="0.004"/>
  </default>

  <asset>
    <material name="dark_chassis" rgba="0.043 0.059 0.090 1.0" roughness="0.6" specular="0.2"/>
    <material name="cyan_accent" rgba="0.024 0.714 0.831 1.0" roughness="0.3" specular="0.5"/>
    <material name="teal_body" rgba="0.078 0.722 0.651 1.0" roughness="0.4" specular="0.4"/>
    <material name="yellow_amber" rgba="0.918 0.702 0.031 1.0" roughness="0.3" specular="0.6"/>
    <material name="tire_rubber" rgba="0.12 0.12 0.14 1.0" roughness="0.8" specular="0.1"/>
    <material name="eye_glow" rgba="0.05 0.95 0.95 1.0" emission="0.8"/>
    <material name="gold_pad" rgba="0.85 0.65 0.12 1.0" roughness="0.2" specular="0.8"/>

    <mesh name="base_mesh" file="base_link.stl" scale="0.001 0.001 0.001"/>
    <mesh name="left_wheel_mesh" file="left_wheel.stl" scale="0.001 0.001 0.001"/>
    <mesh name="right_wheel_mesh" file="right_wheel.stl" scale="0.001 0.001 0.001"/>
    <mesh name="torso_mesh" file="torso_shell.stl" scale="0.001 0.001 0.001"/>
    <mesh name="left_arm_mesh" file="left_arm.stl" scale="0.001 0.001 0.001"/>
    <mesh name="left_pincer_mesh" file="left_pincer.stl" scale="0.001 0.001 0.001"/>
    <mesh name="right_arm_mesh" file="right_arm.stl" scale="0.001 0.001 0.001"/>
    <mesh name="right_pincer_mesh" file="right_pincer.stl" scale="0.001 0.001 0.001"/>
    <mesh name="neck_turret_mesh" file="neck_yaw_turret.stl" scale="0.001 0.001 0.001"/>
    <mesh name="head_mesh" file="head_assembly.stl" scale="0.001 0.001 0.001"/>
    <mesh name="left_ear_mesh" file="left_ear.stl" scale="0.001 0.001 0.001"/>
    <mesh name="right_ear_mesh" file="right_ear.stl" scale="0.001 0.001 0.001"/>
    <mesh name="left_eye_mesh" file="left_eye.stl" scale="0.001 0.001 0.001"/>
    <mesh name="right_eye_mesh" file="right_eye.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <body name="desk_pet" pos="0 0 0.017">
      <freejoint name="root"/>

      <body name="base_link">
        <inertial pos="0 -0.000021 0.010275" mass="0.3761" diaginertia="1.567e-4 1.567e-4 1.567e-4"/>
        <geom name="base_visual" type="mesh" mesh="base_mesh" material="dark_chassis" contype="0" conaffinity="0"/>
        <geom name="base_collision" type="mesh" mesh="base_mesh" material="dark_chassis"/>
        <geom name="front_caster" type="sphere" size="0.007" pos="0 0.040 -0.010" friction="0.02 0.005 0.001" rgba="0.3 0.3 0.35 1"/>
        <geom name="rear_caster" type="sphere" size="0.007" pos="0 -0.040 -0.010" friction="0.02 0.005 0.001" rgba="0.3 0.3 0.35 1"/>

        <!-- Downward Cliff Ray/Rangefinders (1:1 TCRT5000) -->
        <site name="cliff_fl" pos="-0.035 0.040 0.005" zaxis="0 0 -1" size="0.002" rgba="1 0 0 1"/>
        <site name="cliff_fr" pos="0.035 0.040 0.005" zaxis="0 0 -1" size="0.002" rgba="1 0 0 1"/>
        <site name="cliff_rl" pos="-0.035 -0.040 0.005" zaxis="0 0 -1" size="0.002" rgba="1 0 0 1"/>
        <site name="cliff_rr" pos="0.035 -0.040 0.005" zaxis="0 0 -1" size="0.002" rgba="1 0 0 1"/>

        <!-- IMU MPU6050 Site -->
        <site name="imu_site" pos="0 0.002 0.050" size="0.004" rgba="0 1 1 1"/>

        <!-- Left Drive Wheel -->
        <body name="left_wheel" pos="-0.049 0 0">
          <inertial pos="0 0 0" mass="0.0194" diaginertia="8.092e-6 8.092e-6 8.092e-6"/>
          <joint name="left_wheel_joint" type="hinge" axis="-1 0 0" damping="0.001"/>
          <geom name="left_wheel_geom" type="mesh" mesh="left_wheel_mesh" material="tire_rubber" friction="1.2 0.02 0.002"/>
        </body>

        <!-- Right Drive Wheel -->
        <body name="right_wheel" pos="0.049 0 0">
          <inertial pos="0 0 0" mass="0.0194" diaginertia="8.092e-6 8.092e-6 8.092e-6"/>
          <joint name="right_wheel_joint" type="hinge" axis="1 0 0" damping="0.001"/>
          <geom name="right_wheel_geom" type="mesh" mesh="right_wheel_mesh" material="tire_rubber" friction="1.2 0.02 0.002"/>
        </body>

        <!-- Torso -->
        <body name="torso" pos="0 0 0.034">
          <inertial pos="-0.000002 -0.003657 0.057928" mass="0.1409" diaginertia="1.588e-4 1.485e-4 1.614e-4"/>
          <geom name="torso_visual" type="mesh" mesh="torso_mesh" material="teal_body" contype="0" conaffinity="0"/>
          <geom name="torso_collision" type="mesh" mesh="torso_mesh" material="teal_body"/>

          <!-- Left Arm & Pincer -->
          <body name="left_arm" pos="-0.0485 0.002 0.044">
            <inertial pos="0 0 -0.012585" mass="0.0152" diaginertia="1.396e-6 1.365e-6 1.477e-7"/>
            <joint name="left_shoulder_joint" type="hinge" axis="1 0 0" range="-0.6981 2.3562" damping="0.002"/>
            <geom name="left_arm_visual" type="mesh" mesh="left_arm_mesh" material="cyan_accent" contype="0" conaffinity="0"/>
            <geom name="left_arm_collision" type="mesh" mesh="left_arm_mesh" material="cyan_accent"/>

            <body name="left_pincer" pos="0 0 -0.026">
              <inertial pos="0 0 -0.006789" mass="0.0015" diaginertia="4.527e-8 3.138e-8 1.741e-8"/>
              <joint name="left_gripper_joint" type="hinge" axis="0 1 0" range="0.0 0.9599" damping="0.001"/>
              <geom name="left_pincer_visual" type="mesh" mesh="left_pincer_mesh" material="yellow_amber" contype="0" conaffinity="0"/>
              <geom name="left_pincer_collision" type="mesh" mesh="left_pincer_mesh" material="yellow_amber" friction="1.4 0.02 0.005"/>
              <site name="pincer_l_pad" pos="0 0 -0.010" size="0.003" rgba="1 0.8 0 1"/>
            </body>
          </body>

          <!-- Right Arm & Pincer -->
          <body name="right_arm" pos="0.0485 0.002 0.044">
            <inertial pos="0 0 -0.012585" mass="0.0152" diaginertia="1.396e-6 1.365e-6 1.477e-7"/>
            <joint name="right_shoulder_joint" type="hinge" axis="1 0 0" range="-0.6981 2.3562" damping="0.002"/>
            <geom name="right_arm_visual" type="mesh" mesh="right_arm_mesh" material="cyan_accent" contype="0" conaffinity="0"/>
            <geom name="right_arm_collision" type="mesh" mesh="right_arm_mesh" material="cyan_accent"/>

            <body name="right_pincer" pos="0 0 -0.026">
              <inertial pos="0 0 -0.006789" mass="0.0015" diaginertia="4.527e-8 3.138e-8 1.741e-8"/>
              <joint name="right_gripper_joint" type="hinge" axis="0 1 0" range="0.0 0.9599" damping="0.001"/>
              <geom name="right_pincer_visual" type="mesh" mesh="right_pincer_mesh" material="yellow_amber" contype="0" conaffinity="0"/>
              <geom name="right_pincer_collision" type="mesh" mesh="right_pincer_mesh" material="yellow_amber" friction="1.4 0.02 0.005"/>
              <site name="pincer_r_pad" pos="0 0 -0.010" size="0.003" rgba="1 0.8 0 1"/>
            </body>
          </body>

          <!-- Neck Yaw Turret -->
          <body name="neck_turret" pos="0 0 0.062">
            <inertial pos="0 0 0.008" mass="0.0186" diaginertia="1.137e-6 1.296e-6 1.747e-6"/>
            <joint name="neck_yaw_joint" type="hinge" axis="0 0 1" range="-1.3090 1.3090" damping="0.005"/>
            <geom name="neck_turret_visual" type="mesh" mesh="neck_turret_mesh" material="cyan_accent" contype="0" conaffinity="0"/>
            <geom name="neck_turret_collision" type="mesh" mesh="neck_turret_mesh" material="cyan_accent"/>

            <!-- Head Assembly -->
            <body name="head" pos="0 0 0.012">
              <inertial pos="0 0.002872 0.022" mass="0.0827" diaginertia="3.447e-5 3.447e-5 3.447e-5"/>
              <joint name="neck_pitch_joint" type="hinge" axis="1 0 0" range="-0.5236 0.6981" damping="0.005"/>
              <geom name="head_visual" type="mesh" mesh="head_mesh" material="teal_body" contype="0" conaffinity="0"/>
              <geom name="head_collision" type="mesh" mesh="head_mesh" material="teal_body"/>

              <!-- Eyes -->
              <geom name="left_eye_geom" type="mesh" mesh="left_eye_mesh" pos="-0.0135 0.0350 0.0170" material="eye_glow" contype="0" conaffinity="0"/>
              <geom name="right_eye_geom" type="mesh" mesh="right_eye_mesh" pos="0.0135 0.0350 0.0170" material="eye_glow" contype="0" conaffinity="0"/>

              <!-- OV5640 Camera Vision Cone -->
              <camera name="ov5640_cam" pos="0 0.032 0.025" fovy="65" mode="fixed" euler="1.5708 0 0"/>
              <site name="gaze_target_site" pos="0 0.5 0.025" size="0.005" rgba="0 1 0 0.5"/>

              <!-- TTP223 Crown Touch Pad Site -->
              <site name="touch_crown_site" pos="0 0 0.040" size="0.012" material="gold_pad"/>

              <!-- Left Ear -->
              <body name="left_ear" pos="-0.032 0.002 0.030">
                <inertial pos="0 0 0.0147" mass="0.0010" diaginertia="1.463e-7 1.356e-7 1.212e-8"/>
                <joint name="left_ear_joint" type="hinge" axis="1 0 0" range="-1.1345 0.7854" damping="0.002"/>
                <geom name="left_ear_visual" type="mesh" mesh="left_ear_mesh" material="yellow_amber" contype="0" conaffinity="0"/>
                <geom name="left_ear_collision" type="mesh" mesh="left_ear_mesh" material="yellow_amber"/>
              </body>

              <!-- Right Ear -->
              <body name="right_ear" pos="0.032 0.002 0.030">
                <inertial pos="0 0 0.0147" mass="0.0010" diaginertia="1.463e-7 1.356e-7 1.212e-8"/>
                <joint name="right_ear_joint" type="hinge" axis="1 0 0" range="-1.1345 0.7854" damping="0.002"/>
                <geom name="right_ear_visual" type="mesh" mesh="right_ear_mesh" material="yellow_amber" contype="0" conaffinity="0"/>
                <geom name="right_ear_collision" type="mesh" mesh="right_ear_mesh" material="yellow_amber"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- Differential Drive Wheel Actuators -->
    <velocity name="wheel_l_act" joint="left_wheel_joint" kv="20" ctrlrange="-25 25"/>
    <velocity name="wheel_r_act" joint="right_wheel_joint" kv="20" ctrlrange="-25 25"/>

    <!-- 8 Expressive Servos (Position Controlled with SCS0009 & 3.7g limits) -->
    <position name="neck_yaw_act" joint="neck_yaw_joint" kp="15" kv="1.5" ctrlrange="-1.3090 1.3090"/>
    <position name="neck_pitch_act" joint="neck_pitch_joint" kp="15" kv="1.5" ctrlrange="-0.5236 0.6981"/>
    <position name="left_shoulder_act" joint="left_shoulder_joint" kp="18" kv="1.8" ctrlrange="-0.6981 2.3562"/>
    <position name="right_shoulder_act" joint="right_shoulder_joint" kp="18" kv="1.8" ctrlrange="-0.6981 2.3562"/>
    <position name="left_pincer_act" joint="left_gripper_joint" kp="10" kv="1.0" ctrlrange="0.0 0.9599"/>
    <position name="right_pincer_act" joint="right_gripper_joint" kp="10" kv="1.0" ctrlrange="0.0 0.9599"/>
    <position name="left_ear_act" joint="left_ear_joint" kp="8" kv="0.8" ctrlrange="-1.1345 0.7854"/>
    <position name="right_ear_act" joint="right_ear_joint" kp="8" kv="0.8" ctrlrange="-1.1345 0.7854"/>
  </actuator>

  <sensor>
    <rangefinder name="cliff_fl_sensor" site="cliff_fl"/>
    <rangefinder name="cliff_fr_sensor" site="cliff_fr"/>
    <rangefinder name="cliff_rl_sensor" site="cliff_rl"/>
    <rangefinder name="cliff_rr_sensor" site="cliff_rr"/>

    <accelerometer name="imu_accel" site="imu_site"/>
    <gyro name="imu_gyro" site="imu_site"/>

    <jointpos name="encoder_l_pos" joint="left_wheel_joint"/>
    <jointvel name="encoder_l_vel" joint="left_wheel_joint"/>
    <jointpos name="encoder_r_pos" joint="right_wheel_joint"/>
    <jointvel name="encoder_r_vel" joint="right_wheel_joint"/>
  </sensor>
</mujoco>